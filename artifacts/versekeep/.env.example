# ─────────────────────────────────────────────────────────
# VerseKeep — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# ── API.Bible ─────────────────────────────────────────────
# Free key from: https://scripture.api.bible
# Required for full Bible search across 5 translations
# Without it, only locally saved verses are searchable
EXPO_PUBLIC_BIBLE_API_KEY=your_api_bible_key_here

# ── EAS / Expo ────────────────────────────────────────────
# Auto-filled when you run: eas init
# Find in: expo.dev → your project → settings
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── App environment ───────────────────────────────────────
# Set automatically by EAS build profiles
# Values: development | preview | production
APP_ENV=development
